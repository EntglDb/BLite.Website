# Copia questo file in deploy/.env (già escluso da git, vedi .gitignore) e compila
# con i dati reali dell'hosting Plesk. Non committare mai deploy/.env.
#
# Stesso server/credenziali usati per i siti in ~/Documents/GitHub/WebSites/deploy/.env.

# Host SSH del server Plesk (es. server123.tuoprovider.it oppure IP)
PLESK_SSH_HOST=hosting-linux-2.zepfiro.com

# Utente SSH (spesso "admin" per usare i comandi "plesk bin ...")
PLESK_SSH_USER=admin

# Porta SSH (default 22)
PLESK_SSH_PORT=22

# Path alla chiave privata SSH, se usi autenticazione a chiave invece che password
# (lascia vuoto per usare l'agent SSH di default / autenticazione a password interattiva)
PLESK_SSH_KEY=
